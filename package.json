{
  "name": "guifer-portfolio",
  "version": "0.0.0",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 0.0.0.0",
    "dev:api": "tsx watch server/index.ts",
    "build": "npm run build:pages && npm run build:api",
    "build:pages": "vite build && node scripts/generate-static-route-heads.mjs && node scripts/verify-static-route-heads.mjs",
    "build:api": "vite build --config vite.api.config.ts",
    "build:dev": "vite build --mode development",
    "start:api": "node dist-api/server.js",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:api": "tsx --test server/app.test.ts server/env.test.ts server/services/coffee.test.ts server/services/github.test.ts server/services/health.test.ts src/lib/external-contracts.server.test.ts scripts/github-operations-issues.test.mjs scripts/release-verifier.test.mjs",
    "carbon:check": "npm run build:pages && node scripts/verify-carbon-budget.mjs",
    "security:audit": "npm audit --audit-level=high",
    "security:sbom": "npm sbom --package-lock-only --sbom-format cyclonedx --sbom-type application",
    "security:ip-spoof": "node scripts/verify-render-ip-spoofing.mjs",
    "security:production": "node scripts/verify-production-security.mjs",
    "security:rate-limit-atomic": "node scripts/verify-atomic-rate-limit.mjs",
    "release:verify": "node scripts/verify-release.mjs",
    "images:generate": "node scripts/generate-responsive-images.mjs",
    "icons:generate": "node scripts/generate-app-icons.mjs",
    "social:generate": "node scripts/generate-social-images.mjs",
    "fonts:generate": "node scripts/generate-font-subsets.mjs",
    "format": "prettier --write .",
    "test:a11y": "playwright test e2e",
    "test:a11y:headed": "playwright test e2e --headed"
  },
  "dependencies": {
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.2.10",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@supabase/supabase-js": "^2.110.0",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-router": "^1.170.16",
    "@tanstack/router-plugin": "^1.168.18",
    "accessible-web-widget": "1.5.3",
    "clsx": "^2.1.1",
    "lucide-react": "^0.575.0",
    "motion": "^12.42.2",
    "nodemailer": "^9.0.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.7.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.3.4",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "^9.32.0",
    "@playwright/test": "1.61.1",
    "@types/node": "^22.16.5",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "lru-cache": "^11.5.2",
    "prettier": "^3.7.3",
    "sharp": "^0.35.3",
    "subset-font": "^2.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.0.16"
  }
}
